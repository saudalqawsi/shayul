{
  "name": "RentalRequest",
  "type": "object",
  "properties": {
    "equipment_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0639\u062f\u0629"
    },
    "equipment_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0639\u062f\u0629"
    },
    "client_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "company": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0631\u0643\u0629 / \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "location": {
      "type": "string",
      "title": "\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
    },
    "duration": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629"
    },
    "start_date": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0621",
      "format": "date"
    },
    "qty": {
      "type": "number",
      "title": "\u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u0637\u0644\u0648\u0628"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "completed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "title": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0625\u0636\u0627\u0641\u064a\u0629"
    }
  },
  "required": [
    "equipment_id",
    "equipment_name",
    "client_name",
    "phone",
    "location",
    "duration"
  ]
}